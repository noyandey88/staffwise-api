# --- Required ---
NAME=Staffwise API
DESCRIPTION=A Human Resources Management System
VERSION=1.0

DATABASE_URL=postgresql://postgres:2395@localhost:5432/staffwise_dev
JWT_SECRET=wM+BFR5oZWmYrZCJ1VybeulkwzpMjLaYHjLnhiqFFZEHxwpIg3KY4TuWs5rt9pJ2lmSD0M35eaimGHDRuIiE3A==

# --- Development ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_HTTP_BODIES=true
SWAGGER_ENABLED=true
# Token lifetimes in seconds (300 = 5 min, 604800 = 7 days)
JWT_ACCESS_EXPIRES_IN=300
JWT_REFRESH_EXPIRES_IN=604800
# Comma-separated allowed origins; empty disables CORS
CORS_ORIGINS=http://localhost:5173
# Rate limiting: max THROTTLE_LIMIT requests per THROTTLE_TTL seconds
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Docker Compose postgres (must match DATABASE_URL)
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='2395'
POSTGRES_DB='staffwise_dev'
