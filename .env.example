# Copy this file to .env and set the values for your machine.
#DATABASE_URL=postgresql://user:password@localhost:5432/nestjs_starter
#JWT_SECRET=my-strong-local-secret
#PORT=3000
#NAME=Staffwise API
#DESCRIPTION=A Human Resources Management System
#VERSION=1
#LOG_LEVEL=debug
#LOG_PRETTY=true
#LOG_HTTP_BODIES=true
#SWAGGER_ENABLED=true
#CORS_ORIGINS=
#THROTTLE_TTL=60
#THROTTLE_LIMIT=100
#JWT_ACCESS_EXPIRES_IN=300
#JWT_REFRESH_EXPIRES_IN=604800
# @nestjs/observe telemetry — off unless both are set
#OBSERVE_APP_KEY=
#OBSERVE_APP_SECRET=
