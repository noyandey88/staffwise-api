# Copy this file to .env and set the values for your machine.
#DATABASE_URL=postgresql://user:password@localhost:5432/staffwise_dev
# Used by docker-compose's postgres service; keep in sync with DATABASE_URL.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=staffwise_dev
#JWT_SECRET=my-strong-local-secret
#PORT=3000
#NAME=Staffwise API
#DESCRIPTION=A Human Resources Management System
#VERSION=1
#LOG_LEVEL=debug
#LOG_PRETTY=true
#LOG_HTTP_BODIES=true
#SWAGGER_ENABLED=true
#CORS_ORIGINS=
#THROTTLE_TTL=60
#THROTTLE_LIMIT=100
#JWT_ACCESS_EXPIRES_IN=300
#JWT_REFRESH_EXPIRES_IN=604800
# Super admin created on first startup if none exists (set both or neither).
# The password is only used at creation; change it afterwards via PATCH /api/auth/password.
#SUPER_ADMIN_EMAIL=superadmin@example.com
#SUPER_ADMIN_PASSWORD=change-me-please
